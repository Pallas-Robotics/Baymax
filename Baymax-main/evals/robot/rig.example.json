{
  "robot_name": "ember-test-1",
  "person_speaker": {"name": "Rig Speaker", "command": null},
  "gain_db": 0.0,
  "target_spl_dba": 60.0,
  "calibration_file": "~/.config/ember/robot-rig-calibration.json",
  "calibration_tolerance_db": 4.0,
  "display": {"kind": "http", "host": "0.0.0.0", "port": 8790},
  "screen_check": {"enabled": true},
  "fixtures_dir": "~/.local/share/ember/rig-fixtures",
  "reference_mic": {"command": ["arecord", "-q", "-D", "plughw:CARD=RefMic,DEV=0", "-f", "S16_LE", "-r", "48000", "-c", "1", "{wav}"]},
  "light": {"command": ["kasa", "--host", "192.168.50.20", "--type", "bulb", "brightness", "{percent}"], "restore_percent": 100},
  "faults": {"network_drop": {"start": ["sudo", "-n", "/usr/local/sbin/ember-rig-netdrop", "on", "60"],
                              "stop": ["sudo", "-n", "/usr/local/sbin/ember-rig-netdrop", "off"]}},
  "power": {"external_controller": false, "off": null, "on": null, "ready": null, "off_s": 10, "timeout_s": 300},
  "gates": {"default": {"min_pass_rate": 1.0},
            "safety": {"min_trials": 20, "min_pass_rate": 0.95},
            "latency": {"min_trials": 10, "min_wilson_lower": 0.8}},
  "virtual": null,
  "base_env": "/home/ember/ember-deployment/current/Baymax-main/.env",
  "env": {},
  "tts_command": null,
  "voice": null,
  "startup_timeout_s": 180,
  "temp_dir": null
}
